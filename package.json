{
  "name": "connecto",
  "version": "1.0.0",
  "description": "Connect with people doing the same thing as you, right now.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"test/unit/**/*.test.js\" \"test/property/**/*.test.js\" \"test/integration/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:property": "node --test \"test/property/**/*.test.js\"",
    "test:integration": "node --test \"test/integration/**/*.test.js\"",
    "test:coverage": "c8 node --test \"test/unit/**/*.test.js\" \"test/property/**/*.test.js\" \"test/integration/**/*.test.js\"",
    "test:mutation": "stryker run",
    "test:system": "playwright test",
    "test:perf": "node test/performance/match-latency.js",
    "test:ab": "node test/ab/matcher-ab.js",
    "lint": "node --check server.js auth.js db.js matcher.js prefs.js safety.js chat.js friends.js background.js mail.js turn.js embeddings.js"
  },
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "express": "^5.2.1",
    "nodemailer": "^10.0.13",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/tap-runner": "^8.7.1",
    "c8": "^10.1.3",
    "fast-check": "^3.23.2",
    "socket.io-client": "^4.8.4"
  },
  "engines": {
    "node": ">=24"
  }
}
